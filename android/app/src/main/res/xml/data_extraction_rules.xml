<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing is backed up or carried to a new phone (Android 12+; allowBackup in
    the manifest says the same for older versions). The sign-in in the
    WebView's storage would only arrive expired, and the chosen server belongs
    to the phone it was chosen on.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
