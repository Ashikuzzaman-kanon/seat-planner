{
  "name": "seat-planner-backend",
  "version": "1.0.0",
  "description": "Auth + role-based access control API for the Train Seat Planner",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed:superadmin": "node src/seeders/createSuperAdmin.js",
    "seed:testusers": "node src/seeders/createTestUsers.js",
    "seed:unittestusers": "node src/seeders/createUnitTestUsers.js",
    "seed:seatplans": "node src/seeders/importSeatPlans.js",
    "seed:network": "node src/seeders/seedNetwork.js",
    "seed:departures": "node src/seeders/seedDepartures.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:status": "sequelize-cli db:migrate:status",
    "migration:generate": "sequelize-cli migration:generate --name",
    "test": "node --test tests/unit/",
    "test:integration": "node tests/integration/run.js",
    "test:all": "npm test && npm run test:integration",
    "coverage": "c8 --reporter=none node --test tests/unit/ && c8 --clean=false --reporter=none node tests/integration/run.js && c8 report --check-coverage --lines 90 --functions 90 --branches 70"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.9.3",
    "morgan": "^1.10.0",
    "mysql2": "^3.12.0",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.15.2",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.5",
    "sequelize-cli": "^6.6.5"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "jsqr": "^1.4.0",
    "nodemon": "^3.1.9"
  }
}
