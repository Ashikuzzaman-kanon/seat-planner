# Server
PORT=4000
NODE_ENV=development
# Allowed origins for CORS, comma-separated. `*` stands for one piece of a
# host name (no dots), for addresses that change per deploy, e.g.
# https://my-app-*-my-team.vercel.app
CORS_ORIGINS=http://localhost:3000

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=seat_planner
DB_USER=root
DB_PASS=

# JWT
JWT_SECRET=change-me-to-a-long-random-string
# Access tokens are short-lived (permissions are re-read per request); refresh
# tokens are long-lived, stored hashed, and revocable.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Email verification expiry (minutes)
VERIFICATION_CODE_TTL_MIN=15

# MongoDB (document store for audit log / history / notifications; blank = disabled)
MONGO_URI=mongodb://localhost:27017/seat_planner

# Email. Four routes, first one configured wins:
#   1. GMAIL_CLIENT_ID + GMAIL_CLIENT_SECRET + GMAIL_REFRESH_TOKEN — the Gmail
#      API over HTTPS, sending as your own Gmail (about 500 a day, free). For
#      hosts that block outbound SMTP (Render's free tier blocks 25/465/587).
#      The README's "Email in production" section shows how to get the three.
#   2. BREVO_API_KEY — Brevo's HTTP API, also over HTTPS. Free: 300/day. The
#      EMAIL_FROM address must be a sender verified in Brevo.
#   3. EMAIL_HOST — SMTP, e.g. Gmail with an app password, for local use.
#   4. None — codes and tickets are logged to the console instead.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
BREVO_API_KEY=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Seat Planner <no-reply@seatplanner.local>"

# Signs the payload inside a ticket QR so it can be checked without a database
# lookup. Kept apart from JWT_SECRET: ticket signatures are printed on paper and
# must outlive a session-secret rotation. Falls back to JWT_SECRET if unset.
TICKET_SIGNING_SECRET=change-me-to-a-different-long-random-string
# Leave blank: the QR then carries the bare signed token, which is what the
# in-app checker (Check Tickets) reads. Set it only once a public page exists to
# open `<url>?t=<token>` — there is none yet, and the checker cannot read a URL.
TICKET_VERIFY_URL=

# Bootstrap super admin (used by `npm run seed:superadmin`)
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe123!
